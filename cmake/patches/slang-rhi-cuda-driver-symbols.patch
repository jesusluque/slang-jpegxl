diff --git a/include/slang-rhi/cuda-driver-api.h b/include/slang-rhi/cuda-driver-api.h
index 2e1e2df..ca25d92 100644
--- a/include/slang-rhi/cuda-driver-api.h
+++ b/include/slang-rhi/cuda-driver-api.h
@@ -796,6 +796,14 @@ enum CUjit_option
 #define CUDA_SYM(x) extern x;
 #endif
 
+// The loaded driver entry points are this library's own. They carry the
+// driver's names, so at global scope they are the definitions every other
+// object in the program binds to -- a program that also uses the CUDA driver
+// directly (gpe, OIDN) then calls through these pointers instead of through
+// libcuda, and crashes on the null one. Inside a namespace they keep their
+// names for this library and collide with nothing outside it.
+namespace rhi::cuda_driver {
+
 // clang-format off
 CUDA_SYM(CUresult (*cuGetErrorString)(CUresult, const char**));
 CUDA_SYM(CUresult (*cuGetErrorName)(CUresult, const char**));
@@ -891,6 +899,10 @@ CUDA_SYM(CUresult (*cuSurfObjectCreate)(CUsurfObject*, const CUDA_RESOURCE_DESC*
 CUDA_SYM(CUresult (*cuSurfObjectDestroy)(CUsurfObject));
 CUDA_SYM(CUresult (*cuTexObjectCreate)(CUtexObject*, const CUDA_RESOURCE_DESC*, const CUDA_TEXTURE_DESC*, const CUDA_RESOURCE_VIEW_DESC*));
 CUDA_SYM(CUresult (*cuTexObjectDestroy)(CUtexObject));
+
+} // namespace rhi::cuda_driver
+
+using namespace rhi::cuda_driver;
 // clang-format on
 
 #define CU_LAUNCH_PARAM_END_AS_INT 0x00
