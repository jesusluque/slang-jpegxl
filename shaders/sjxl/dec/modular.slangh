// Copyright (c) 2026 jesus luque.
//
// Modular image decoding for one thread: GroupHeader, MA trees, the fourteen
// predictors and the weighted predictor, the inverse RCT and palette
// transforms. A port of libjxl's modular/encoding/{encoding.cc, dec_ma.cc,
// context_predict.h} and modular/transform/{rct,palette}.cc, in the general
// (tree lookup per pixel) form; libjxl's fast tracks are optimisations of it.
//
// Requires entropy.slangh (and its `cs`/`arena` globals) included first.
//
// Channels live in the arena: a descriptor array of kChanWords words per
// channel (w, h, hshift, vshift, dataOff) and w*h ints at dataOff.
#pragma once

static const uint kChanWords = 8;
static const uint kChanW = 0;
static const uint kChanH = 1;
static const uint kChanHShift = 2;
static const uint kChanVShift = 3;
static const uint kChanData = 4;
static const uint kChanStride = 5;   // words per row (the width, or the full image's for a group view)
static const uint kMaxChannels = 256;   // Squeeze multiplies channels: 3 x (1 + 2 x levels)

static const uint kTreeWords = 8;   // property(int, -1 leaf), splitval, lchild, rchild, predictor, offset, multiplier, leaf id
static const uint kMaxTreeNodes = 8192;

static const uint kNumStaticProperties = 2;
static const uint kNumNonrefProperties = kNumStaticProperties + 13 + 1;   // 16
static const uint kWpProp = kNumNonrefProperties - 1;                      // 15
static const uint kMaxProperties = kNumNonrefProperties + 4 * kMaxChannels;

static const uint kPredZero = 0, kPredLeft = 1, kPredTop = 2, kPredAverage0 = 3, kPredSelect = 4, kPredGradient = 5,
                  kPredWeighted = 6, kPredTopRight = 7, kPredTopLeft = 8, kPredLeftLeft = 9, kPredAverage1 = 10,
                  kPredAverage2 = 11, kPredAverage3 = 12, kPredAverage4 = 13;

struct Channel {
    uint w, h;
    int hshift, vshift;
    uint data;     // arena offset
    uint stride;   // words per row: w, or the full channel's width for a group view
};

Channel loadChannel(uint chansOff, uint i) {
    Channel c;
    const uint o = chansOff + i * kChanWords;
    c.w = arena[o + kChanW];
    c.h = arena[o + kChanH];
    c.hshift = int(arena[o + kChanHShift]);
    c.vshift = int(arena[o + kChanVShift]);
    c.data = arena[o + kChanData];
    c.stride = arena[o + kChanStride];
    return c;
}

void storeChannel(uint chansOff, uint i, Channel c) {
    const uint o = chansOff + i * kChanWords;
    arena[o + kChanW] = c.w;
    arena[o + kChanH] = c.h;
    arena[o + kChanHShift] = uint(c.hshift);
    arena[o + kChanVShift] = uint(c.vshift);
    arena[o + kChanData] = c.data;
    arena[o + kChanStride] = c.stride;
}

/// A channel with zeroed storage.
Channel newChannel(inout Dec d, uint w, uint h, int hshift, int vshift) {
    Channel c;
    c.w = w;
    c.h = h;
    c.hshift = hshift;
    c.vshift = vshift;
    c.stride = w;
    c.data = alloc(d, max(w * h, 1u));
    for (uint i = 0; i < w * h; ++i) arena[c.data + i] = 0;
    return c;
}

/// A channel over storage that is already zero (a fresh arena).
Channel newChannelUncleared(inout Dec d, uint w, uint h, int hshift, int vshift) {
    Channel c;
    c.w = w;
    c.h = h;
    c.hshift = hshift;
    c.vshift = vshift;
    c.stride = w;
    c.data = alloc(d, max(w * h, 1u));
    return c;
}

/// The rectangle (x0, y0, w, h) of `full` as a channel of its own: a group's view.
Channel channelView(Channel full, uint x0, uint y0, uint w, uint h) {
    Channel v = full;
    v.w = w;
    v.h = h;
    v.data = full.data + y0 * full.stride + x0;
    return v;
}

int px(Channel c, uint x, uint y) { return int(arena[c.data + y * c.stride + x]); }
void setPx(Channel c, uint x, uint y, int v) { arena[c.data + y * c.stride + x] = uint(v); }

// --- weighted predictor header and state -----------------------------------------------

struct WpHeader {
    int p1C, p2C, p3Ca, p3Cb, p3Cc, p3Cd, p3Ce;
    uint w0, w1, w2, w3;
};

WpHeader defaultWpHeader() {
    WpHeader h;
    h.p1C = 16; h.p2C = 10; h.p3Ca = 7; h.p3Cb = 7; h.p3Cc = 7; h.p3Cd = 0; h.p3Ce = 0;
    h.w0 = 0xd; h.w1 = 0xc; h.w2 = 0xc; h.w3 = 0xc;
    return h;
}

WpHeader readWpHeader(inout Dec d) {
    WpHeader h = defaultWpHeader();
    if (brRead(d.br, 1) != 0) return h;   // all_default
    h.p1C = int(brRead(d.br, 5));
    h.p2C = int(brRead(d.br, 5));
    h.p3Ca = int(brRead(d.br, 5));
    h.p3Cb = int(brRead(d.br, 5));
    h.p3Cc = int(brRead(d.br, 5));
    h.p3Cd = int(brRead(d.br, 5));
    h.p3Ce = int(brRead(d.br, 5));
    h.w0 = brRead(d.br, 4);
    h.w1 = brRead(d.br, 4);
    h.w2 = brRead(d.br, 4);
    h.w3 = brRead(d.br, 4);
    return h;
}

static const uint kWpDivLookup[64] = {
    16777216, 8388608, 5592405, 4194304, 3355443, 2796202, 2396745, 2097152, 1864135, 1677721, 1525201, 1398101, 1290555,
    1198372, 1118481, 1048576, 986895, 932067, 883011, 838860, 798915, 762600, 729444, 699050, 671088, 645277, 621378,
    599186, 578524, 559240, 541200, 524288, 508400, 493447, 479349, 466033, 453438, 441505, 430185, 419430, 409200,
    399457, 390167, 381300, 372827, 364722, 356962, 349525, 342392, 335544, 328965, 322638, 316551, 310689, 305040,
    299593, 294337, 289262, 284359, 279620, 275036, 270600, 266305, 262144};

static const int kWpExtraBits = 3;

static const uint kWpSharedWords = 2600;   // 10 KB: 5 rows of 2 x (xsize + 2), channels up to 258 wide (DC groups, 256 px modular groups)
groupshared uint gWp[kWpSharedWords];
/// The MA tree's nodes copied into threadgroup memory when they fit (a tree walk
/// reads three or four words per node visited, for every sample).
static const uint kTreeSharedNodes = 256;   // 8 KB: one uint4 per node (split: property, split value, children; leaf: -1, offset, multiplier, predictor | context << 8)
groupshared uint4 gTree4[kTreeSharedNodes];
/// kWpDivLookup in threadgroup memory (a dynamically indexed constant array is a
/// device memory load; this one is in every sample's dependent chain, five times).
groupshared uint gWpDiv[64];

/// ErrorWeight: libjxl sums the three uint32 errors (wrapping) and takes FloorLog2Nonzero
/// of the 64-bit x + 1; x itself fits 32 bits, so only x = 0xFFFFFFFF needs the wide case.
uint wpErrorWeight(uint x, uint maxweight) {
    int shift = (x == 0xFFFFFFFFu ? 32 : int(firstbithigh(x + 1))) - 5;
    if (shift < 0) shift = 0;
    const uint div = gWpDiv[shift >= 32 ? 0 : (x >> shift)];
    return 4 + uint((uint64_t(maxweight) * uint64_t(div)) >> shift);
}
static const int kWpRound = ((1 << kWpExtraBits) >> 1) - 1;

// --- MA tree --------------------------------------------------------------------------

struct Tree {
    uint nodes;      // arena offset
    uint numNodes;
    uint numLeaves;
    uint codeSet;    // the data histograms (one context per leaf)
    bool usesWp;     // some leaf predicts Weighted or some node splits on the WP property
};

/// DecodeTree: its own histograms over 6 contexts, then the nodes.
Tree decodeTree(inout Dec d, uint windowOff) {
    Tree t;
    t.numNodes = 0;
    t.numLeaves = 0;
    t.usesWp = false;
    t.codeSet = 0;
    const uint treeCode = decodeHistograms(d, 6, false, windowOff);
    t.nodes = alloc(d, kMaxTreeNodes * kTreeWords);
    if (d.error != kErrNone) return t;
    SymReader r = makeSymReader(d, treeCode, windowOff, 0);
    uint toDecode = 1;
    uint leafId = 0;
    while (toDecode > 0 && d.error == kErrNone) {
        if (t.numNodes >= kMaxTreeNodes) { fail(d, kErrArena); return t; }
        --toDecode;
        const uint prop1 = readHybridUint(d, r, 1);
        if (prop1 > 256) { fail(d, kErrCorrupt); return t; }
        const uint n = t.nodes + t.numNodes * kTreeWords;
        if (prop1 == 0) {
            const uint predictor = readHybridUint(d, r, 2);
            if (predictor >= 14) { fail(d, kErrCorrupt); return t; }
            const int offset = unpackSignedInt(readHybridUint(d, r, 3));
            const uint mulLog = readHybridUint(d, r, 4);
            if (mulLog >= 31) { fail(d, kErrCorrupt); return t; }
            const uint mulBits = readHybridUint(d, r, 5);
            if (mulBits >= (1u << (31u - mulLog)) - 1u) { fail(d, kErrCorrupt); return t; }
            arena[n + 0] = uint(-1);
            arena[n + 1] = 0;
            arena[n + 2] = leafId;
            arena[n + 3] = 0;
            arena[n + 4] = predictor;
            arena[n + 5] = uint(offset);
            arena[n + 6] = (mulBits + 1) << mulLog;
            arena[n + 7] = leafId;
            if (predictor == kPredWeighted) t.usesWp = true;
            ++leafId;
            ++t.numNodes;
            continue;
        }
        const int splitval = unpackSignedInt(readHybridUint(d, r, 0));
        arena[n + 0] = prop1 - 1;
        arena[n + 1] = uint(splitval);
        arena[n + 2] = t.numNodes + toDecode + 1;
        arena[n + 3] = t.numNodes + toDecode + 2;
        arena[n + 4] = kPredZero;
        arena[n + 5] = 0;
        arena[n + 6] = 1;
        arena[n + 7] = 0;
        if (prop1 - 1 == kWpProp) t.usesWp = true;
        ++t.numNodes;
        toDecode += 2;
    }
    t.numLeaves = leafId;
    if (!checkFinalState(r)) fail(d, kErrCorrupt);
    return t;
}

// --- transforms (fields) -------------------------------------------------------------

static const uint kTransformWords = 12;
static const uint kTrId = 0, kTrBeginC = 1, kTrRctType = 2, kTrNumC = 3, kTrNbColors = 4, kTrNbDeltas = 5, kTrPredictor = 6,
                  kTrNumSqueezes = 7, kTrSqueezesOff = 8;   // squeezes: 4 words each (horizontal, in_place, begin_c, num_c)
static const uint kTrRct = 0, kTrPalette = 1, kTrSqueeze = 2;
static const uint kSqWords = 4, kSqHorizontal = 0, kSqInPlace = 1, kSqBeginC = 2, kSqNumC = 3;
static const uint kMaxSqueezes = 64;   // room for the default parameters of a 2^30 px image

/// Transform::VisitFields.
void readTransform(inout Dec d, uint off) {
    const uint id = brU32(d.br, distrVal(0), distrVal(1), distrVal(2), distrVal(3));
    arena[off + kTrId] = id;
    if (id == 3) { fail(d, kErrCorrupt); return; }
    if (id == kTrRct || id == kTrPalette) {
        arena[off + kTrBeginC] = brU32(d.br, distrBitsOffset(3, 0), distrBitsOffset(6, 8), distrBitsOffset(10, 72), distrBitsOffset(13, 1096));
    }
    if (id == kTrRct) {
        arena[off + kTrRctType] = brU32(d.br, distrVal(6), distrBitsOffset(2, 0), distrBitsOffset(4, 2), distrBitsOffset(6, 10));
        if (arena[off + kTrRctType] >= 42) fail(d, kErrCorrupt);
    }
    if (id == kTrPalette) {
        arena[off + kTrNumC] = brU32(d.br, distrVal(1), distrVal(3), distrVal(4), distrBitsOffset(13, 1));
        arena[off + kTrNbColors] = brU32(d.br, distrBitsOffset(8, 0), distrBitsOffset(10, 256), distrBitsOffset(12, 1280), distrBitsOffset(16, 5376));
        arena[off + kTrNbDeltas] = brU32(d.br, distrVal(0), distrBitsOffset(8, 1), distrBitsOffset(10, 257), distrBitsOffset(16, 1281));
        arena[off + kTrPredictor] = brRead(d.br, 4);
        if (arena[off + kTrPredictor] >= 14) fail(d, kErrCorrupt);
    }
    if (id == kTrSqueeze) {
        const uint num = brU32(d.br, distrVal(0), distrBitsOffset(4, 1), distrBitsOffset(6, 9), distrBitsOffset(8, 41));
        if (num > kMaxSqueezes) { fail(d, kErrCorrupt); return; }
        arena[off + kTrNumSqueezes] = num;
        const uint sq = alloc(d, kMaxSqueezes * kSqWords);   // defaults are filled in at MetaApply when num == 0
        arena[off + kTrSqueezesOff] = sq;
        if (d.error != kErrNone) return;
        for (uint i = 0; i < num; ++i) {
            const uint o = sq + i * kSqWords;
            arena[o + kSqHorizontal] = brRead(d.br, 1);
            arena[o + kSqInPlace] = brRead(d.br, 1);
            arena[o + kSqBeginC] = brU32(d.br, distrBitsOffset(3, 0), distrBitsOffset(6, 8), distrBitsOffset(10, 72), distrBitsOffset(13, 1096));
            arena[o + kSqNumC] = brU32(d.br, distrVal(1), distrVal(2), distrVal(3), distrBitsOffset(4, 4));
        }
    }
}

/// squeeze.cc DefaultSqueezeParameters: the parameters an empty list stands for.
void defaultSqueezeParameters(uint off, uint chansOff, uint numChannels, uint nbMeta) {
    const uint sq = arena[off + kTrSqueezesOff];
    uint num = 0;
    const uint nbChannels = numChannels - nbMeta;
    const Channel first = loadChannel(chansOff, nbMeta);
    uint w = first.w;
    uint h = first.h;
    const bool wide = w > h;
    if (nbChannels > 2) {
        const Channel second = loadChannel(chansOff, nbMeta + 1);
        if (second.w == w && second.h == h) {
            // (the comment in libjxl says 4:2:0 chroma; it fires for every RGB image)
            for (uint k = 0; k < 2 && num < kMaxSqueezes; ++k) {   // horizontal, then vertical
                const uint o = sq + num * kSqWords;
                arena[o + kSqHorizontal] = k == 0 ? 1u : 0u;
                arena[o + kSqInPlace] = 0;
                arena[o + kSqBeginC] = nbMeta + 1;
                arena[o + kSqNumC] = 2;
                ++num;
            }
        }
    }
    if (!wide && h > 8 && num < kMaxSqueezes) {
        const uint o = sq + num * kSqWords;
        arena[o + kSqHorizontal] = 0; arena[o + kSqInPlace] = 1; arena[o + kSqBeginC] = nbMeta; arena[o + kSqNumC] = nbChannels;
        ++num;
        h = (h + 1) / 2;
    }
    while ((w > 8 || h > 8) && num + 1 < kMaxSqueezes) {
        if (w > 8) {
            const uint o = sq + num * kSqWords;
            arena[o + kSqHorizontal] = 1; arena[o + kSqInPlace] = 1; arena[o + kSqBeginC] = nbMeta; arena[o + kSqNumC] = nbChannels;
            ++num;
            w = (w + 1) / 2;
        }
        if (h > 8) {
            const uint o = sq + num * kSqWords;
            arena[o + kSqHorizontal] = 0; arena[o + kSqInPlace] = 1; arena[o + kSqBeginC] = nbMeta; arena[o + kSqNumC] = nbChannels;
            ++num;
            h = (h + 1) / 2;
        }
    }
    arena[off + kTrNumSqueezes] = num;
}

/// Inserts `c` at index `at` of the channel list (descriptors after it move up).
void insertChannel(uint chansOff, inout uint numChannels, uint at, Channel c) {
    for (uint i = numChannels; i > at; --i) storeChannel(chansOff, i, loadChannel(chansOff, i - 1));
    storeChannel(chansOff, at, c);
    ++numChannels;
}

/// Removes `count` channels starting at `at`.
void eraseChannels(uint chansOff, inout uint numChannels, uint at, uint count) {
    for (uint i = at; i + count < numChannels; ++i) storeChannel(chansOff, i, loadChannel(chansOff, i + count));
    numChannels -= count;
}

/// squeeze.cc MetaSqueeze: halves the squeezed channels and inserts the residual
/// channels (with storage) where the inverse expects them.
void metaSqueeze(inout Dec d, uint off, uint chansOff, inout uint numChannels, inout uint nbMeta) {
    if (arena[off + kTrNumSqueezes] == 0) defaultSqueezeParameters(off, chansOff, numChannels, nbMeta);
    const uint num = arena[off + kTrNumSqueezes];
    const uint sq = arena[off + kTrSqueezesOff];
    for (uint i = 0; i < num; ++i) {
        const uint o = sq + i * kSqWords;
        const bool horizontal = arena[o + kSqHorizontal] != 0;
        const bool inPlace = arena[o + kSqInPlace] != 0;
        const uint beginC = arena[o + kSqBeginC];
        const uint numC = arena[o + kSqNumC];
        const uint endC = beginC + numC - 1;
        if (beginC >= numChannels || endC >= numChannels || endC < beginC) { fail(d, kErrCorrupt); return; }
        if (numChannels + numC > kMaxChannels) { fail(d, kErrCorrupt); return; }
        if (beginC < nbMeta) {
            if (endC >= nbMeta || !inPlace) { fail(d, kErrCorrupt); return; }
            nbMeta += numC;
        }
        const uint offset = inPlace ? endC + 1 : numChannels;
        for (uint c = beginC; c <= endC; ++c) {
            Channel ch = loadChannel(chansOff, c);
            if (ch.hshift > 30 || ch.vshift > 30 || ch.w == 0 || ch.h == 0) { fail(d, kErrCorrupt); return; }
            uint w = ch.w, h = ch.h;
            if (horizontal) {
                ch.w = (w + 1) / 2;
                if (ch.hshift >= 0) ch.hshift++;
                w = w - (w + 1) / 2;
            } else {
                ch.h = (h + 1) / 2;
                if (ch.vshift >= 0) ch.vshift++;
                h = h - (h + 1) / 2;
            }
            ch.stride = ch.w;   // shrink(): the smaller channel is contiguous in its storage
            storeChannel(chansOff, c, ch);
            const Channel residual = newChannelUncleared(d, w, h, ch.hshift, ch.vshift);
            if (d.error != kErrNone) return;
            insertChannel(chansOff, numChannels, offset + (c - beginC), residual);
        }
    }
}

int smoothTendency(int B, int a, int n) {
    int diff = 0;
    if (B >= a && a >= n) {
        diff = (4 * B - 3 * n - a + 6) / 12;
        if (diff - (diff & 1) > 2 * (B - a)) diff = 2 * (B - a) + 1;
        if (diff + (diff & 1) > 2 * (a - n)) diff = 2 * (a - n);
    } else if (B <= a && a <= n) {
        diff = (4 * B - 3 * n - a - 6) / 12;
        if (diff + (diff & 1) < 2 * (B - a)) diff = 2 * (B - a) - 1;
        if (diff - (diff & 1) < 2 * (a - n)) diff = 2 * (a - n);
    }
    return diff;
}

/// InvHSqueeze: channel c (averages) and rc (residuals) into a channel twice as wide.
void invHSqueeze(inout Dec d, uint chansOff, uint c, uint rc) {
    Channel chin = loadChannel(chansOff, c);
    const Channel res = loadChannel(chansOff, rc);
    if (chin.w != (chin.w + res.w + 1) / 2 || chin.h != res.h) { fail(d, kErrCorrupt); return; }
    if (res.w == 0) { chin.hshift--; storeChannel(chansOff, c, chin); return; }
    Channel chout = newChannelUncleared(d, chin.w + res.w, chin.h, chin.hshift - 1, chin.vshift);
    if (d.error != kErrNone) return;
    for (uint y = 0; y < chin.h; ++y) {
        for (uint x = 0; x < res.w; ++x) {
            const int diffMinusTendency = px(res, x, y);
            const int avg = px(chin, x, y);
            const int nextAvg = x + 1 < chin.w ? px(chin, x + 1, y) : avg;
            const int left = x > 0 ? px(chout, 2 * x - 1, y) : avg;
            const int diff = diffMinusTendency + smoothTendency(left, avg, nextAvg);
            const int A = avg + diff / 2;
            setPx(chout, 2 * x, y, A);
            setPx(chout, 2 * x + 1, y, A - diff);
        }
        if ((chout.w & 1) != 0) setPx(chout, chout.w - 1, y, px(chin, chin.w - 1, y));
    }
    storeChannel(chansOff, c, chout);
}

/// InvVSqueeze: channel c (averages) and rc (residuals) into a channel twice as tall.
void invVSqueeze(inout Dec d, uint chansOff, uint c, uint rc) {
    Channel chin = loadChannel(chansOff, c);
    const Channel res = loadChannel(chansOff, rc);
    if (chin.h != (chin.h + res.h + 1) / 2 || chin.w != res.w) { fail(d, kErrCorrupt); return; }
    if (res.h == 0) { chin.vshift--; storeChannel(chansOff, c, chin); return; }
    Channel chout = newChannelUncleared(d, chin.w, chin.h + res.h, chin.hshift, chin.vshift - 1);
    if (d.error != kErrNone) return;
    for (uint y = 0; y < res.h; ++y) {
        for (uint x = 0; x < chin.w; ++x) {
            const int avg = px(chin, x, y);
            const int nextAvg = y + 1 < chin.h ? px(chin, x, y + 1) : avg;
            const int top = y > 0 ? px(chout, x, 2 * y - 1) : avg;
            const int diff = px(res, x, y) + smoothTendency(top, avg, nextAvg);
            const int o = avg + diff / 2;
            setPx(chout, x, 2 * y, o);
            setPx(chout, x, 2 * y + 1, o - diff);
        }
    }
    if ((chout.h & 1) != 0) {
        const uint y = chin.h - 1;
        for (uint x = 0; x < chin.w; ++x) setPx(chout, x, 2 * y, px(chin, x, y));
    }
    storeChannel(chansOff, c, chout);
}

/// InvSqueeze over the channel list, last parameter first.
void invSqueeze(inout Dec d, uint off, uint chansOff, inout uint numChannels, inout uint nbMeta) {
    const uint num = arena[off + kTrNumSqueezes];
    const uint sq = arena[off + kTrSqueezesOff];
    for (uint i = num; i > 0; --i) {
        const uint o = sq + (i - 1) * kSqWords;
        const bool horizontal = arena[o + kSqHorizontal] != 0;
        const bool inPlace = arena[o + kSqInPlace] != 0;
        const uint beginC = arena[o + kSqBeginC];
        const uint numC = arena[o + kSqNumC];
        const uint endC = beginC + numC - 1;
        if (beginC >= numChannels || endC >= numChannels || endC < beginC) { fail(d, kErrCorrupt); return; }
        const uint offset = inPlace ? endC + 1 : numChannels + beginC - endC - 1;
        if (beginC < nbMeta) {
            if (nbMeta <= numC) { fail(d, kErrCorrupt); return; }
            nbMeta -= numC;
        }
        for (uint c = beginC; c <= endC; ++c) {
            const uint rc = offset + c - beginC;
            if (rc >= numChannels) { fail(d, kErrCorrupt); return; }
            const Channel a = loadChannel(chansOff, c);
            const Channel r = loadChannel(chansOff, rc);
            if (a.w < r.w || a.h < r.h) { fail(d, kErrCorrupt); return; }
            if (horizontal) invHSqueeze(d, chansOff, c, rc);
            else invVSqueeze(d, chansOff, c, rc);
            if (d.error != kErrNone) return;
        }
        eraseChannels(chansOff, numChannels, offset, numC);
    }
}

/// The channel list after MetaApply of a transform.
void metaApply(inout Dec d, uint off, uint chansOff, inout uint numChannels, inout uint nbMeta) {
    const uint id = arena[off + kTrId];
    if (id == kTrSqueeze) { metaSqueeze(d, off, chansOff, numChannels, nbMeta); return; }
    if (id == kTrRct) {
        const uint b = arena[off + kTrBeginC];
        if (b + 2 >= numChannels) { fail(d, kErrCorrupt); return; }
        const Channel c0 = loadChannel(chansOff, b);
        for (uint i = 1; i < 3; ++i) {
            const Channel ci = loadChannel(chansOff, b + i);
            if (ci.w != c0.w || ci.h != c0.h || ci.hshift != c0.hshift || ci.vshift != c0.vshift) { fail(d, kErrCorrupt); return; }
        }
        return;
    }
    if (id == kTrPalette) {
        const uint beginC = arena[off + kTrBeginC];
        const uint numC = arena[off + kTrNumC];
        const uint endC = beginC + numC - 1;
        if (endC >= numChannels || numChannels + 1 > kMaxChannels) { fail(d, kErrCorrupt); return; }
        const Channel c0 = loadChannel(chansOff, beginC);
        for (uint i = beginC + 1; i <= endC; ++i) {
            const Channel ci = loadChannel(chansOff, i);
            if (ci.w != c0.w || ci.h != c0.h || ci.hshift != c0.hshift || ci.vshift != c0.vshift) { fail(d, kErrCorrupt); return; }
        }
        if (beginC >= nbMeta) {
            nbMeta += 1;
        } else {
            if (endC >= nbMeta) { fail(d, kErrCorrupt); return; }
            nbMeta += 2 - numC;
        }
        // Erase channels beginC+1 .. endC.
        const uint erased = endC - beginC;
        for (uint i = beginC + 1; i + erased < numChannels; ++i) {
            storeChannel(chansOff, i, loadChannel(chansOff, i + erased));
        }
        numChannels -= erased;
        // Insert the palette channel (nb_colors + nb_deltas) x numC at 0.
        for (uint i = numChannels; i > 0; --i) {
            storeChannel(chansOff, i, loadChannel(chansOff, i - 1));
        }
        const Channel pal = newChannel(d, arena[off + kTrNbColors] + arena[off + kTrNbDeltas], numC, -1, -1);
        storeChannel(chansOff, 0, pal);
        ++numChannels;
    }
}

// --- channel decoding ------------------------------------------------------------------

struct ChannelDecodeArgs {
    uint chansOff;
    uint numChannels;
    uint chan;
    uint streamId;
};


/// Samples beyond 16 bits (floats, 24/32-bit ints) take the 64-bit variant (set per kernel from its params).
groupshared uint gWideSamples;

#define PIXW int
#define WPX(name) name##32
#include "sjxl/dec/modular_channel.slangh"
#undef PIXW
#undef WPX
#define PIXW int64_t
#define WPX(name) name##64
#include "sjxl/dec/modular_channel.slangh"
#undef PIXW
#undef WPX

void decodeChannel(inout Dec d, inout SymReader r, Tree tree, WpHeader wpHeader, ChannelDecodeArgs a) {
    if (gWideSamples != 0) decodeChannel64(d, r, tree, wpHeader, a);
    else decodeChannel32(d, r, tree, wpHeader, a);
}

// --- inverse transforms ----------------------------------------------------------------

int pixelAdd(int a, int b) { return int(uint(a) + uint(b)); }

void invRct(inout Dec d, uint off, uint chansOff) {
    const uint m = arena[off + kTrBeginC];
    const uint rctType = arena[off + kTrRctType];
    if (rctType == 0) return;
    const uint permutation = rctType / 7;
    const uint custom = rctType % 7;
    Channel c0 = loadChannel(chansOff, m);
    Channel c1 = loadChannel(chansOff, m + 1);
    Channel c2 = loadChannel(chansOff, m + 2);
    if (custom != 0) {
        const uint second = custom >> 1;
        const uint third = custom & 1;
        const uint n = c0.w * c0.h;
        for (uint i = 0; i < n; ++i) {
            if (custom == 6) {
                const int Y = int(arena[c0.data + i]);
                const int Co = int(arena[c1.data + i]);
                const int Cg = int(arena[c2.data + i]);
                const int tmp = pixelAdd(Y, -(Cg >> 1));
                const int G = pixelAdd(Cg, tmp);
                const int B = pixelAdd(tmp, -(Co >> 1));
                const int R = pixelAdd(B, Co);
                arena[c0.data + i] = uint(R);
                arena[c1.data + i] = uint(G);
                arena[c2.data + i] = uint(B);
            } else {
                const int first = int(arena[c0.data + i]);
                int sec = int(arena[c1.data + i]);
                int thr = int(arena[c2.data + i]);
                if (third != 0) thr = pixelAdd(thr, first);
                if (second == 1) sec = pixelAdd(sec, first);
                else if (second == 2) sec = pixelAdd(sec, pixelAdd(first, thr) >> 1);
                arena[c1.data + i] = uint(sec);
                arena[c2.data + i] = uint(thr);
            }
        }
    }
    // Channel permutation.
    storeChannel(chansOff, m + (permutation % 3), c0);
    storeChannel(chansOff, m + ((permutation + 1 + permutation / 3) % 3), c1);
    storeChannel(chansOff, m + ((permutation + 2 - permutation / 3) % 3), c2);
}

static const int kDeltaPalette[72][3] = {
    {0, 0, 0},       {4, 4, 4},       {11, 0, 0},      {0, 0, -13},     {0, -12, 0},     {-10, -10, -10}, {-18, -18, -18},
    {-27, -27, -27}, {-18, -18, 0},   {0, 0, -32},     {-32, 0, 0},     {-37, -37, -37}, {0, -32, -32},   {24, 24, 45},
    {50, 50, 50},    {-45, -24, -24}, {-24, -45, -45}, {0, -24, -24},   {-34, -34, 0},   {-24, 0, -24},   {-45, -45, -24},
    {64, 64, 64},    {-32, 0, -32},   {0, -32, 0},     {-32, 0, 32},    {-24, -45, -24}, {45, 24, 45},    {24, -24, -45},
    {-45, -24, 24},  {80, 80, 80},    {64, 0, 0},      {0, 0, -64},     {0, -64, -64},   {-24, -24, 45},  {96, 96, 96},
    {64, 64, 0},     {45, -24, -24},  {34, -34, 0},    {112, 112, 112}, {24, -45, -45},  {45, 45, -24},   {0, -32, 32},
    {24, -24, 45},   {0, 96, 96},     {45, -24, 24},   {24, -45, -24},  {-24, -45, 24},  {0, -64, 0},     {96, 0, 0},
    {128, 128, 128}, {64, 0, 64},     {144, 144, 144}, {96, 96, 0},     {-36, -36, 36},  {45, -24, -45},  {45, -45, -24},
    {0, 0, -96},     {0, 128, 128},   {0, 96, 0},      {45, 24, -45},   {-128, 0, 0},    {24, -45, 24},   {-45, 24, -45},
    {64, 0, -64},    {64, -64, -64},  {96, 0, 96},     {45, -45, 24},   {24, 45, -45},   {64, 64, -64},   {128, 128, 0},
    {0, 0, -128},    {-24, 45, -45}};

int paletteScale(uint value, uint bitDepth) {
    // (value * ((1 << bit_depth) - 1)) >> 2
    return int((uint64_t(value) * uint64_t((1u << bitDepth) - 1)) >> 2);
}

/// palette_internal::GetPaletteValue: explicit, implicit cube and delta entries.
int paletteValue(Channel palette, int index, uint c, int paletteSize, uint bitDepth) {
    const int kLargeCubeOffset = 4 * 4 * 4;
    if (index < 0) {
        if (c >= 3) return 0;
        index = -(index + 1);
        index %= 1 + 2 * (72 - 1);
        int result = kDeltaPalette[(index + 1) >> 1][c] * ((index & 1) != 0 ? 1 : -1);
        if (bitDepth > 8) result *= 1 << (bitDepth - 8);
        return result;
    } else if (paletteSize <= index && index < paletteSize + kLargeCubeOffset) {
        if (c >= 3) return 0;
        index -= paletteSize;
        index >>= c * 2;
        return paletteScale(uint(index % 4), bitDepth) + (1 << max(0, int(bitDepth) - 3));
    } else if (paletteSize + kLargeCubeOffset <= index) {
        if (c >= 3) return 0;
        index -= paletteSize + kLargeCubeOffset;
        if (c == 1) index /= 5;
        else if (c == 2) index /= 25;
        return paletteScale(uint(index % 5), bitDepth);
    }
    return px(palette, uint(index), c);
}

void invPalette(inout Dec d, uint off, uint chansOff, inout uint numChannels, inout uint nbMeta, WpHeader wpHeader, uint bitDepth) {
    const uint beginC = arena[off + kTrBeginC];
    const uint nbDeltas = arena[off + kTrNbDeltas];
    const uint predictor = arena[off + kTrPredictor];
    if (nbMeta < 1) { fail(d, kErrCorrupt); return; }
    const Channel palette = loadChannel(chansOff, 0);
    const uint nb = palette.h;
    const uint c0 = beginC + 1;
    if (c0 >= numChannels || nb < 1 || numChannels + nb - 1 > kMaxChannels) { fail(d, kErrCorrupt); return; }
    const Channel indices = loadChannel(chansOff, c0);
    const uint w = indices.w;
    const uint h = indices.h;
    // Insert nb - 1 channels after c0.
    for (uint i = numChannels; i > c0 + 1; --i) {
        storeChannel(chansOff, i + nb - 2, loadChannel(chansOff, i - 1));
    }
    for (uint i = 1; i < nb; ++i) {
        storeChannel(chansOff, c0 + i, newChannel(d, w, h, indices.hshift, indices.vshift));
    }
    numChannels += nb - 1;
    if (d.error != kErrNone) return;
    const int paletteSize = int(palette.w);
    if (w == 0) {
    } else if (nbDeltas == 0 && predictor == kPredZero) {
        // Indices become values; channel 0 of the group is overwritten last.
        for (uint c = nb; c > 0; --c) {
            const Channel out = loadChannel(chansOff, c0 + c - 1);
            for (uint y = 0; y < h; ++y) {
                for (uint x = 0; x < w; ++x) {
                    int index = px(indices, x, y);
                    if (nb == 1) index = clamp(index, 0, paletteSize - 1);
                    setPx(out, x, y, paletteValue(palette, index, c - 1, paletteSize, bitDepth));
                }
            }
        }
    } else {
        // Delta palette: indices kept aside, each channel predicted.
        const Channel idx = newChannel(d, w, h, 0, 0);
        if (d.error != kErrNone) return;
        for (uint i = 0; i < w * h; ++i) arena[idx.data + i] = arena[indices.data + i];
        for (uint c = 0; c < nb; ++c) {
            const Channel channel = loadChannel(chansOff, c0 + c);
            WpState64 wp;
            if (predictor == kPredWeighted) {
                wp = wpCreate64(d, wpHeader, w);
                if (d.error != kErrNone) return;
            }
            for (uint y = 0; y < h; ++y) {
                for (uint x = 0; x < w; ++x) {
                    const int index = px(idx, x, y);
                    const int entry = paletteValue(palette, index, c, paletteSize, bitDepth);
                    const int left = x > 0 ? px(channel, x - 1, y) : (y > 0 ? px(channel, x, y - 1) : 0);
                    const int top = y > 0 ? px(channel, x, y - 1) : left;
                    const int topleft = (x > 0 && y > 0) ? px(channel, x - 1, y - 1) : left;
                    const int topright = (x + 1 < w && y > 0) ? px(channel, x + 1, y - 1) : top;
                    const int leftleft = x > 1 ? px(channel, x - 2, y) : left;
                    const int toptop = y > 1 ? px(channel, x, y - 2) : top;
                    const int toprightright = (x + 2 < w && y > 0) ? px(channel, x + 2, y - 1) : topright;
                    int64_t wpPred = 0;
                    if (predictor == kPredWeighted) {
                        int unused;
                        wpPred = wpPredict64(wp, x, y, int64_t(top), int64_t(left), int64_t(topright), int64_t(topleft), int64_t(toptop), unused);
                    }
                    int64_t val = entry;
                    if (index < int(nbDeltas)) {
                        val += predictOne64(predictor, int64_t(left), int64_t(top), int64_t(toptop), int64_t(topleft), int64_t(topright),
                                          int64_t(leftleft), int64_t(toprightright), wpPred);
                    }
                    setPx(channel, x, y, int(val));
                    if (predictor == kPredWeighted) wpUpdateErrors64(wp, val, x, y);
                }
            }
        }
    }
    if (c0 >= nbMeta) {
        nbMeta -= 1;
    } else {
        nbMeta -= 2 - nb;
    }
    // Erase the palette channel.
    for (uint i = 0; i + 1 < numChannels; ++i) {
        storeChannel(chansOff, i, loadChannel(chansOff, i + 1));
    }
    --numChannels;
}

// --- a whole modular stream --------------------------------------------------------------

struct GlobalTree {
    bool present;
    Tree tree;
};

/// The GroupHeader of a modular stream and the transforms it declares.
struct StreamHeader {
    uint useGlobalTree;
    WpHeader wp;
    uint numTransforms;
    uint transformsOff;   // kTransformWords each
    uint nbMeta;          // meta channels (palettes) after MetaApply
};

static const uint kStreamHeaderWords = 16;

void storeStreamHeader(uint off, StreamHeader h) {
    arena[off + 0] = h.useGlobalTree;
    arena[off + 1] = uint(h.wp.p1C); arena[off + 2] = uint(h.wp.p2C);
    arena[off + 3] = uint(h.wp.p3Ca); arena[off + 4] = uint(h.wp.p3Cb); arena[off + 5] = uint(h.wp.p3Cc);
    arena[off + 6] = uint(h.wp.p3Cd); arena[off + 7] = uint(h.wp.p3Ce);
    arena[off + 8] = h.wp.w0; arena[off + 9] = h.wp.w1; arena[off + 10] = h.wp.w2; arena[off + 11] = h.wp.w3;
    arena[off + 12] = h.numTransforms;
    arena[off + 13] = h.transformsOff;
    arena[off + 14] = h.nbMeta;
}

StreamHeader loadStreamHeader(uint off) {
    StreamHeader h;
    h.useGlobalTree = arena[off + 0];
    h.wp.p1C = int(arena[off + 1]); h.wp.p2C = int(arena[off + 2]);
    h.wp.p3Ca = int(arena[off + 3]); h.wp.p3Cb = int(arena[off + 4]); h.wp.p3Cc = int(arena[off + 5]);
    h.wp.p3Cd = int(arena[off + 6]); h.wp.p3Ce = int(arena[off + 7]);
    h.wp.w0 = arena[off + 8]; h.wp.w1 = arena[off + 9]; h.wp.w2 = arena[off + 10]; h.wp.w3 = arena[off + 11];
    h.numTransforms = arena[off + 12];
    h.transformsOff = arena[off + 13];
    h.nbMeta = arena[off + 14];
    return h;
}

/// ModularDecode's first part: GroupHeader (use_global_tree, wp_header, transforms)
/// and MetaApply of every transform on the channel list at chansOff.
StreamHeader readStreamHeader(inout Dec d, uint chansOff, inout uint numChannels) {
    StreamHeader h;
    h.useGlobalTree = brRead(d.br, 1);
    h.wp = readWpHeader(d);
    h.numTransforms = brU32(d.br, distrVal(0), distrVal(1), distrBitsOffset(4, 2), distrBitsOffset(8, 18));
    h.transformsOff = alloc(d, max(h.numTransforms, 1u) * kTransformWords);
    h.nbMeta = 0;
    if (d.error != kErrNone) return h;
    for (uint i = 0; i < h.numTransforms; ++i) {
        readTransform(d, h.transformsOff + i * kTransformWords);
        if (d.error != kErrNone) return h;
        metaApply(d, h.transformsOff + i * kTransformWords, chansOff, numChannels, h.nbMeta);
        if (d.error != kErrNone) return h;
    }
    return h;
}

/// Whether channel i stops the stream: a non-meta channel wider or taller than maxChanSize.
bool stopsStream(Channel c, uint i, uint nbMeta, uint maxChanSize) {
    return i >= nbMeta && (c.w > maxChanSize || c.h > maxChanSize);
}

/// ModularDecode's second part: the tree (local, or the frame's global one), the
/// symbols and every channel up to the first that stops the stream. Returns the
/// index of that channel (numChannels when every channel was decoded).
uint decodeStreamChannels(inout Dec d, StreamHeader h, uint chansOff, uint numChannels, uint streamId, GlobalTree global,
                          uint windowOff, uint maxChanSize) {
    uint distanceMultiplier = 0;
    uint numChans = 0;
    uint end = numChannels;
    for (uint i = 0; i < numChannels; ++i) {
        const Channel c = loadChannel(chansOff, i);
        if (stopsStream(c, i, h.nbMeta, maxChanSize)) { end = i; break; }
        if (c.w == 0 || c.h == 0) continue;
        distanceMultiplier = max(distanceMultiplier, c.w);
        ++numChans;
    }
    if (numChans == 0) return end;
    Tree tree;
    if (h.useGlobalTree == 0) {
        tree = decodeTree(d, windowOff);
        if (d.error != kErrNone) return end;
        tree.codeSet = decodeHistograms(d, (tree.numNodes + 1) / 2, false, windowOff);
        if (d.error != kErrNone) return end;
    } else {
        if (!global.present) { fail(d, kErrCorrupt); return end; }
        tree = global.tree;
    }
    SymReader r = makeSymReader(d, tree.codeSet, windowOff, distanceMultiplier);
    if (d.error != kErrNone) return end;
    for (uint i = 0; i < end; ++i) {
        ChannelDecodeArgs a;
        a.chansOff = chansOff;
        a.numChannels = numChannels;
        a.chan = i;
        a.streamId = streamId;
        decodeChannel(d, r, tree, h.wp, a);
        if (d.error != kErrNone) return end;
    }
    if (!checkFinalState(r)) fail(d, kErrCorrupt);
    return end;
}

/// Image::undo_transforms over the channel list.
void undoTransforms(inout Dec d, StreamHeader h, uint chansOff, inout uint numChannels, uint bitDepth) {
    uint nbMeta = h.nbMeta;
    for (uint i = h.numTransforms; i > 0; --i) {
        const uint off = h.transformsOff + (i - 1) * kTransformWords;
        const uint id = arena[off + kTrId];
        if (id == kTrRct) invRct(d, off, chansOff);
        else if (id == kTrPalette) invPalette(d, off, chansOff, numChannels, nbMeta, h.wp, bitDepth);
        else if (id == kTrSqueeze) invSqueeze(d, off, chansOff, numChannels, nbMeta);
        if (d.error != kErrNone) return;
    }
}

/// ModularGenericDecompress with undo_transforms: GroupHeader, transforms,
/// local or global tree, every channel, inverse transforms. The channel
/// descriptors at chansOff (numChannels entries, each with storage) are the
/// image; on return they hold the decoded channels (the count may change).
void decodeModularStream(inout Dec d, uint chansOff, inout uint numChannels, uint streamId, GlobalTree global,
                         uint windowOff, uint bitDepth) {
    if (numChannels == 0) return;
    const StreamHeader h = readStreamHeader(d, chansOff, numChannels);
    if (d.error != kErrNone) return;
    decodeStreamChannels(d, h, chansOff, numChannels, streamId, global, windowOff, 0xFFFFFFFFu);
    if (d.error != kErrNone) return;
    undoTransforms(d, h, chansOff, numChannels, bitDepth);
}
