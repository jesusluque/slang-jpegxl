//
// A Modular frame (lossless, or lossy modular in XYB): libjxl
// ModularFrameDecoder. The globals thread reads DcGlobal (the DC dequant
// factors, the frame's global tree, then the global modular stream: GroupHeader,
// transforms, and every channel no larger than the group dimension). Each group
// thread decodes its rectangle of the remaining channels straight into the
// full-image channels through a strided view (DecodeGroup + CopyImageTo in one
// step), and the finalise thread undoes the transforms over the full image
// (FinalizeDecoding). The channels then go to float planes (modular_out.slang).
//
// Needs entropy.slangh, modular.slangh and frame.slangh (readDequantDc,
// readGlobalModular, globalTree) included before.

static const uint kGsModChansOff = 48;        // full-image channel descriptors
static const uint kGsModNumChannels = 49;
static const uint kGsModBeginC = 50;          // first channel the groups decode
static const uint kGsModHeaderOff = 51;       // StreamHeader of the global stream
static const uint kGsModColorChannels = 52;   // 1 (grey) or 3
static const uint kGsModBitDepth = 53;

struct ModularFrameGeom {
    uint xsize, ysize;      // pixels (coded)
    uint groupDim;          // pixels
    uint colorChannels;     // 1 or 3 for a Modular frame, 0 for VarDCT (only the extra channels are modular)
    uint bitDepth;
    uint numEc;             // extra channels (<= 4)
    uint4 ecW, ecH;         // their sizes: ceil(output size / ec_upsampling)
    uint4 ecShift;          // log2(ec_upsampling) - log2(upsampling)
};

uint quadAt(uint4 v, uint i) { return i == 0 ? v.x : i == 1 ? v.y : i == 2 ? v.z : v.w; }

/// DecodeGlobalInfo's modular image: the colour channels at the coded size, then the
/// extra channels, then the global stream (GroupHeader, transforms, the channels that
/// fit a group). Called after the frame's global tree was read.
void decodeModularImage(inout Dec d, ModularFrameGeom g, uint windowOff) {
    const uint chansOff = alloc(d, kMaxChannels * kChanWords);
    if (d.error != kErrNone) return;
    uint numChannels = 0;
    for (uint c = 0; c < g.colorChannels; ++c) {
        const Channel ch = newChannelUncleared(d, g.xsize, g.ysize, 0, 0);
        if (d.error != kErrNone) return;
        storeChannel(chansOff, numChannels++, ch);
    }
    for (uint e = 0; e < g.numEc; ++e) {
        const int shift = int(quadAt(g.ecShift, e));
        const Channel ch = newChannelUncleared(d, quadAt(g.ecW, e), quadAt(g.ecH, e), shift, shift);
        if (d.error != kErrNone) return;
        storeChannel(chansOff, numChannels++, ch);
    }
    arena[kGsModChansOff] = chansOff;
    arena[kGsModNumChannels] = numChannels;
    arena[kGsModBeginC] = numChannels;
    arena[kGsModColorChannels] = g.colorChannels;
    arena[kGsModBitDepth] = g.bitDepth;
    if (numChannels == 0) return;   // ModularDecode: nothing follows an empty image
    const uint headerOff = alloc(d, kStreamHeaderWords);
    if (d.error != kErrNone) return;
    StreamHeader h = readStreamHeader(d, chansOff, numChannels);
    if (d.error != kErrNone) return;
    const uint beginC = decodeStreamChannels(d, h, chansOff, numChannels, 0, globalTree(), windowOff, g.groupDim);
    if (d.error != kErrNone) return;
    storeStreamHeader(headerOff, h);
    arena[kGsModNumChannels] = numChannels;
    arena[kGsModBeginC] = beginC;
    arena[kGsModHeaderOff] = headerOff;
}

/// DcGlobal of a Modular frame.
void decodeModularGlobal(inout Dec d, ModularFrameGeom g, uint windowOff) {
    readDequantDc(d);
    if (d.error != kErrNone) return;
    readGlobalModular(d, windowOff);
    if (d.error != kErrNone) return;
    decodeModularImage(d, g, windowOff);
}

/// ModularFrameDecoder::DecodeGroup for the rectangle (x0, y0, w, h) in pixels:
/// the channels from beginC whose shift lies in [minShift, maxShift], decoded
/// as views into the full image with the group's own GroupHeader.
void decodeModularGroup(inout Dec d, uint x0, uint y0, uint w, uint h, int minShift, int maxShift, uint streamId, uint windowOff) {
    const uint fullOff = arena[kGsModChansOff];
    const uint numFull = arena[kGsModNumChannels];
    const uint beginC = arena[kGsModBeginC];
    if (beginC >= numFull) return;   // nothing left for the groups (a VarDCT frame without extra channels): no bits, no arena
    const uint localOff = alloc(d, kMaxChannels * kChanWords);
    if (d.error != kErrNone) return;
    uint numLocal = 0;
    for (uint c = beginC; c < numFull; ++c) {
        const Channel fc = loadChannel(fullOff, c);
        const int shift = min(fc.hshift, fc.vshift);
        if (shift < minShift || shift > maxShift) continue;
        const uint rx0 = x0 >> fc.hshift, ry0 = y0 >> fc.vshift;
        if (rx0 >= fc.w || ry0 >= fc.h) continue;
        const uint rw = min(w >> fc.hshift, fc.w - rx0);
        const uint rh = min(h >> fc.vshift, fc.h - ry0);
        if (rw == 0 || rh == 0) continue;
        storeChannel(localOff, numLocal, channelView(fc, rx0, ry0, rw, rh));
        ++numLocal;
    }
    if (numLocal == 0) return;   // nothing to read: the section is empty
    // Keep the views: a group with its own transforms (cjxl picks an RCT per group with
    // small groups) decodes into local storage, undoes them, and is copied into the image.
    const uint viewsOff = alloc(d, numLocal * kChanWords);
    if (d.error != kErrNone) return;
    for (uint i = 0; i < numLocal; ++i) storeChannel(viewsOff, i, loadChannel(localOff, i));
    uint n = numLocal;
    const StreamHeader gh = readStreamHeader(d, localOff, n);
    if (d.error != kErrNone) return;
    if (gh.numTransforms == 0) {
        decodeStreamChannels(d, gh, localOff, n, streamId, globalTree(), windowOff, 0xFFFFFFFFu);
        return;
    }
    // MetaApply may have inserted meta channels (local already) and dropped some views:
    // every remaining view becomes a local channel of the same shape.
    for (uint i = 0; i < n; ++i) {
        Channel c = loadChannel(localOff, i);
        if (c.stride == c.w) continue;   // local (palette) channel
        bool isView = false;
        for (uint v = 0; v < numLocal && !isView; ++v) isView = loadChannel(viewsOff, v).data == c.data;
        if (!isView) continue;
        storeChannel(localOff, i, newChannel(d, c.w, c.h, c.hshift, c.vshift));
        if (d.error != kErrNone) return;
    }
    decodeStreamChannels(d, gh, localOff, n, streamId, globalTree(), windowOff, 0xFFFFFFFFu);
    if (d.error != kErrNone) return;
    undoTransforms(d, gh, localOff, n, arena[kGsModBitDepth]);
    if (d.error != kErrNone) return;
    if (n != numLocal) { fail(d, kErrCorrupt); return; }
    for (uint i = 0; i < numLocal; ++i) {   // CopyImageTo
        const Channel src = loadChannel(localOff, i);
        const Channel dst = loadChannel(viewsOff, i);
        if (src.w != dst.w || src.h != dst.h) { fail(d, kErrCorrupt); return; }
        for (uint y = 0; y < dst.h; ++y) for (uint x = 0; x < dst.w; ++x) setPx(dst, x, y, px(src, x, y));
    }
}

/// FinalizeDecoding: the inverse transforms over the full image.
void modularFinalize(inout Dec d) {
    const uint chansOff = arena[kGsModChansOff];
    uint numChannels = arena[kGsModNumChannels];
    if (numChannels == 0) return;
    const StreamHeader h = loadStreamHeader(arena[kGsModHeaderOff]);
    undoTransforms(d, h, chansOff, numChannels, arena[kGsModBitDepth]);
    arena[kGsModNumChannels] = numChannels;
}
