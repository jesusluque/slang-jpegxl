//
// The encoder side of libjxl's ANS (enc_ans.cc): a histogram normalised to
// 4096, its serialisation (ANSEncodingHistogram::Encode: the small form for
// one or two symbols, else the general form with shift 13 so every count is
// exact, no run-length coding), the alias table the decoder will build from
// it inverted into a reverse map (ANSBuildInfoTable), and the symbol coder.
// The decoder reads this with dec/entropy.slangh readAnsHistogram /
// initAliasTable / readSymbol.
//
// Per code region r (256 symbols): ansInfo[r * 256 + s] = freq | start << 16
// and ansReverse[r * 4096 + start + offset] = the 12-bit slot that decodes to
// (s, offset).
#pragma once

#include "sjxl/common/bitio.slangh"

static const uint kAnsLogTabSize = 12;
static const uint kAnsTabSize = 1u << kAnsLogTabSize;
static const uint kAnsSignature = 0x13;
static const uint kAnsInfoStride = 256;
static const uint kAnsReverseStride = kAnsTabSize;
static const uint kAnsShift = 13;   // every count exact

groupshared uint gAnsCounts[256];
groupshared uint gAnsRaw[256];     // the raw counts a histogram is normalised from
groupshared uint gAnsSame[256];    // ansWriteHistogramAt: run lengths
groupshared uint gAnsWidth[256];   // ansWriteHistogramAt: count bit widths

void storeVarLenUint8(RWStructuredBuffer<uint> buf, inout SerialWriter w, uint n) {
    if (n == 0) {
        serialWrite(buf, w, 1, 0);
        return;
    }
    serialWrite(buf, w, 1, 1);
    const uint nbits = firstbithigh(n);
    serialWrite(buf, w, 3, nbits);
    serialWrite(buf, w, nbits, n - (1u << nbits));
}

/// `n` <= 32 bits of `v` at absolute bit `pos` of the region at `base`, by its owner.
void serialWriteAt(RWStructuredBuffer<uint> buf, uint base, uint pos, uint n, uint v) {
    if (n == 0) {
        return;
    }
    const uint wi = base + (pos >> 5);
    const uint s = pos & 31;
    if (n < 32) {
        v &= (1u << n) - 1;
    }
    buf[wi] |= v << s;
    if (s + n > 32) {
        buf[wi + 1] |= v >> (32 - s);
    }
}

/// gAnsCounts[0..length) scaled to sum to 4096, every present symbol at least 1.
/// GetPopulationCountPrecision: the bits of a count of magnitude `logcount`
/// kept at precision `shift`.
uint ansCountPrecision(uint logcount, uint shift) {
    const int r = min(int(logcount), int(shift) - int((kAnsLogTabSize - logcount) >> 1));
    return r < 0 ? 0u : uint(r);
}

/// SmallestIncrementLog: log2 of the step between representable counts around `count`.
uint ansIncrementLog(uint count, uint shift) {
    if (count == 0) return 0;
    const uint bits = firstbithigh(count);
    return bits - ansCountPrecision(bits, shift);
}

/// The largest representable count below `count` at the precision (1 at least).
uint ansLowerCount(uint count, uint shift) {
    if (count <= 1) return 1;
    uint v = count - 1;
    v &= ~((1u << ansIncrementLog(v, shift)) - 1);
    return max(v, 1u);
}

/// gAnsCounts[0..length) from the raw counts: every non-zero count at least 1,
/// the others rounded to the precision's representable values, and the most
/// frequent symbol (the omitted one, implied by the decoder) taking what is
/// left of kAnsTabSize; if nothing is left, the largest other counts step down.
void ansNormalizeShift(uint length, uint shift) {
    uint total = 0;
    uint omitPos = 0;
    for (uint s = 0; s < length; ++s) {
        total += gAnsRaw[s];
        if (gAnsRaw[s] > gAnsRaw[omitPos]) omitPos = s;
    }
    if (total == 0) {
        for (uint s = 0; s < length; ++s) gAnsCounts[s] = 0;
        gAnsCounts[0] = kAnsTabSize;
        return;
    }
    uint sum = 0;
    for (uint s = 0; s < length; ++s) {
        uint v = 0;
        if (gAnsRaw[s] != 0) {
            v = max(1u, uint(round(float(gAnsRaw[s]) * float(kAnsTabSize) / float(total))));
            v = min(v, kAnsTabSize - 1);
            v &= ~((1u << ansIncrementLog(v, shift)) - 1);
            v = max(v, 1u);
        }
        gAnsCounts[s] = v;
        if (s != omitPos) sum += v;
    }
    while (sum >= kAnsTabSize) {
        uint largest = 0xFFFFFFFFu;
        for (uint s = 0; s < length; ++s) {
            if (s != omitPos && gAnsCounts[s] > 1 && (largest == 0xFFFFFFFFu || gAnsCounts[s] > gAnsCounts[largest])) largest = s;
        }
        if (largest == 0xFFFFFFFFu) break;
        const uint lower = ansLowerCount(gAnsCounts[largest], shift);
        sum -= gAnsCounts[largest] - lower;
        gAnsCounts[largest] = lower;
    }
    gAnsCounts[omitPos] = kAnsTabSize - sum;
}

/// ansNormalize: the exact normalisation (precision 11, every count kept).
void ansNormalize(uint length) {
    for (uint s = 0; s < 256; ++s) gAnsRaw[s] = s < length ? gAnsCounts[s] : 0;
    ansNormalizeShift(length, kAnsLogTabSize - 1);
}

// enc_ans.cc kBitWidthLengths / kBitWidthSymbols: the static code of count bit widths.
static const uint kBitWidthLengths[14] = {5, 4, 4, 4, 4, 4, 3, 3, 3, 3, 3, 6, 7, 7};
static const uint kBitWidthSymbols[14] = {17, 11, 15, 3, 9, 7, 4, 2, 5, 6, 0, 33, 1, 65};
static const uint kAnsRleSymbol = kAnsLogTabSize + 1;   // the width code that starts a run
static const uint kAnsMinReps = 5;

void ansPut(RWStructuredBuffer<uint> buf, inout SerialWriter w, uint n, uint v, bool dry) {
    if (dry) w.pos += n;
    else serialWrite(buf, w, n, v);
}

void ansPutVarLenUint8(RWStructuredBuffer<uint> buf, inout SerialWriter w, uint n, bool dry) {
    if (dry) w.pos += n == 0 ? 1 : 1 + 3 + firstbithigh(n);
    else storeVarLenUint8(buf, w, n);
}

/// ANSEncodingHistogram::Encode of gAnsCounts[0..length) normalised at
/// `shift` (dry: only the size), with libjxl's run-length code for repeated
/// counts. `flat` writes the flat form instead (counts 4096 / length).
void ansWriteHistogramAt(RWStructuredBuffer<uint> buf, inout SerialWriter w, uint length, uint shift, bool flat, bool dry) {
    uint numSymbols = 0;
    uint symbols[2] = {0, 0};
    for (uint s = 0; s < length; ++s) {
        if (gAnsCounts[s] != 0) {
            if (numSymbols < 2) symbols[numSymbols] = s;
            ++numSymbols;
        }
    }
    if (!flat && numSymbols <= 2) {
        ansPut(buf, w, 1, 1, dry);   // small
        if (numSymbols == 0) {
            ansPut(buf, w, 1, 0, dry);
            ansPutVarLenUint8(buf, w, 0, dry);
            return;
        }
        ansPut(buf, w, 1, numSymbols - 1, dry);
        for (uint i = 0; i < numSymbols; ++i) ansPutVarLenUint8(buf, w, symbols[i], dry);
        if (numSymbols == 2) ansPut(buf, w, kAnsLogTabSize, gAnsCounts[symbols[0]], dry);
        return;
    }
    ansPut(buf, w, 1, 0, dry);   // not small
    if (flat) {
        ansPut(buf, w, 1, 1, dry);
        ansPutVarLenUint8(buf, w, length - 1, dry);
        return;
    }
    ansPut(buf, w, 1, 0, dry);   // not flat
    // Elias-gamma-like code of method = shift + 1 (no terminating 0 at the upper bound 3 bits).
    const uint method = min(shift, kAnsLogTabSize - 1) + 1;
    const uint lg = firstbithigh(method);
    ansPut(buf, w, lg, (1u << lg) - 1, dry);
    if (lg != 3) ansPut(buf, w, 1, 0, dry);
    ansPut(buf, w, lg, method & ((1u << lg) - 1), dry);
    ansPutVarLenUint8(buf, w, length - 3, dry);
    uint omitPos = 0;
    for (uint s = 1; s < length; ++s) {
        if (gAnsCounts[s] > gAnsCounts[omitPos]) omitPos = s;
    }
    // Runs of identical counts (not across the omitted position).
    for (uint s = 0; s < length; ++s) gAnsSame[s] = 0;
    uint last = 0;
    for (uint i = 1; i <= length; ++i) {
        if (i == length || i == omitPos || i == omitPos + 1 || gAnsCounts[i] != gAnsCounts[last]) {
            gAnsSame[last] = i - last;
            last = i;
        }
    }
    uint omitWidth = 10;
    for (uint s = 0; s < length; ++s) {
        gAnsWidth[s] = 0;
        if (s != omitPos && gAnsCounts[s] > 0) {
            gAnsWidth[s] = firstbithigh(gAnsCounts[s]) + 1;
            omitWidth = max(omitWidth, gAnsWidth[s] + (s < omitPos ? 1u : 0u));
        }
    }
    gAnsWidth[omitPos] = omitWidth;
    for (uint s = 0; s < length; ++s) {
        ansPut(buf, w, kBitWidthLengths[gAnsWidth[s]], kBitWidthSymbols[gAnsWidth[s]], dry);
        if (gAnsSame[s] >= kAnsMinReps) {
            ansPut(buf, w, kBitWidthLengths[kAnsRleSymbol], kBitWidthSymbols[kAnsRleSymbol], dry);
            ansPutVarLenUint8(buf, w, gAnsSame[s] - kAnsMinReps, dry);
            s += gAnsSame[s] - 1;
        }
    }
    if (shift != 0) {
        for (uint s = 0; s < length; ++s) {
            if (gAnsWidth[s] > 1 && s != omitPos) {
                const uint bitcount = ansCountPrecision(gAnsWidth[s] - 1, shift);
                const uint drop = gAnsWidth[s] - 1 - bitcount;
                ansPut(buf, w, bitcount, (gAnsCounts[s] >> drop) - (1u << bitcount), dry);
            }
            if (gAnsSame[s] >= kAnsMinReps) s += gAnsSame[s] - 1;
        }
    }
}

/// The bits the data would take under gAnsCounts (normalised) given the raw counts.
float ansDataBits(uint length) {
    float bits = 0.0f;
    for (uint s = 0; s < length; ++s) {
        if (gAnsRaw[s] != 0 && gAnsCounts[s] != 0) bits += float(gAnsRaw[s]) * (float(kAnsLogTabSize) - log2(float(gAnsCounts[s])));
    }
    return bits;
}

/// ANSEncodingHistogram::ComputeBest (libjxl's approximate strategy, what its
/// modular streams use at the hare tier): the raw counts in gAnsRaw[0..length)
/// normalised at the even precisions 0..10 and 11 and as the flat histogram;
/// the cheapest description (a dry run) plus data bits, with the choice in
/// `bestShift` / `bestFlat`. Leaves gAnsCounts at the last candidate tried.
/// `numTries` is a runtime value on purpose: a constant trip count gets the loop
/// unrolled around the large writer and the GPU backend compiler never finishes.
float ansBestHistogramChoice(RWStructuredBuffer<uint> buf, uint length, uint numSymbols, uint numTries, out uint bestShift, out bool bestFlat) {
    bestShift = kAnsLogTabSize - 1;
    bestFlat = false;
    if (numSymbols <= 2) {
        ansNormalizeShift(length, kAnsLogTabSize - 1);
        SerialWriter dryW;
        dryW.base = 0;
        dryW.pos = 0;
        ansWriteHistogramAt(buf, dryW, length, kAnsLogTabSize - 1, false, true);
        return float(dryW.pos) + ansDataBits(length);
    }
    const uint shifts[7] = {0, 2, 4, 6, 8, 10, kAnsLogTabSize - 1};
    float bestCost = 3.4e38f;
    for (uint k = 0; k < min(numTries, 7u); ++k) {
        ansNormalizeShift(length, shifts[k]);
        SerialWriter dryW;
        dryW.base = 0;
        dryW.pos = 0;
        ansWriteHistogramAt(buf, dryW, length, shifts[k], false, true);
        const float cost = float(dryW.pos) + ansDataBits(length);
        if (cost < bestCost) { bestCost = cost; bestShift = shifts[k]; bestFlat = false; }
    }
    {
        // The flat histogram: counts 4096 / length, the first 4096 % length one more.
        const uint base = kAnsTabSize / length, rem = kAnsTabSize % length;
        for (uint s = 0; s < length; ++s) gAnsCounts[s] = base + (s < rem ? 1 : 0);
        SerialWriter dryW;
        dryW.base = 0;
        dryW.pos = 0;
        ansWriteHistogramAt(buf, dryW, length, 0, true, true);
        const float cost = float(dryW.pos) + ansDataBits(length);
        if (cost < bestCost) { bestCost = cost; bestFlat = true; }
    }
    return bestCost;
}

/// The cost (description plus data bits) of the raw counts in gAnsCounts[0..length)
/// under their cheapest histogram form (ANSPopulationCost).
float ansBestHistogramCost(RWStructuredBuffer<uint> buf, uint length, uint numTries) {
    uint numSymbols = 0;
    for (uint s = 0; s < 256; ++s) {
        gAnsRaw[s] = s < length ? gAnsCounts[s] : 0;
        if (gAnsRaw[s] != 0) ++numSymbols;
    }
    uint shift;
    bool flat;
    return ansBestHistogramChoice(buf, length, numSymbols, numTries, shift, flat);
}

/// The raw counts in gAnsCounts[0..length) written in their cheapest form;
/// gAnsCounts holds the normalised counts on exit for the alias tables.
void ansWriteBestHistogram(RWStructuredBuffer<uint> buf, inout SerialWriter w, uint length, uint numTries) {
    uint numSymbols = 0;
    for (uint s = 0; s < 256; ++s) {
        gAnsRaw[s] = s < length ? gAnsCounts[s] : 0;
        if (gAnsRaw[s] != 0) ++numSymbols;
    }
    uint bestShift;
    bool bestFlat;
    ansBestHistogramChoice(buf, length, numSymbols, numTries, bestShift, bestFlat);
    if (numSymbols <= 2) {
        ansNormalizeShift(length, kAnsLogTabSize - 1);
        ansWriteHistogramAt(buf, w, length, kAnsLogTabSize - 1, false, false);
        return;
    }
    if (bestFlat) {
        const uint base = kAnsTabSize / length, rem = kAnsTabSize % length;
        for (uint s = 0; s < length; ++s) gAnsCounts[s] = base + (s < rem ? 1 : 0);
        ansWriteHistogramAt(buf, w, length, 0, true, false);
    } else {
        ansNormalizeShift(length, bestShift);
        ansWriteHistogramAt(buf, w, length, bestShift, false, false);
    }
}

/// The serialised histogram gAnsCounts[0..length) (normalised exactly).
void ansWriteHistogram(RWStructuredBuffer<uint> buf, inout SerialWriter w, uint length) {
    ansWriteHistogramAt(buf, w, length, kAnsLogTabSize - 1, false, false);
}

/// The alias table of gAnsCounts[0..length) with 1 << logAlpha buckets
/// (ans_common.cc InitAliasTable), inverted into region r of info / reverse.
void ansBuildTables(RWStructuredBuffer<uint> info, RWStructuredBuffer<uint> reverse, uint r, uint length, uint logAlpha) {
    const uint tableSize = 1u << logAlpha;
    const uint logEntrySize = kAnsLogTabSize - logAlpha;
    const uint entrySize = 1u << logEntrySize;
    uint cutoffs[256], under[256], over[256], rightv[256], offs1[256];
    for (uint i = 0; i < 256; ++i) {
        cutoffs[i] = 0;
        rightv[i] = i;
        offs1[i] = 0;
    }
    int single = -1;
    for (uint s = 0; s < length; ++s) {
        if (gAnsCounts[s] == kAnsTabSize) single = int(s);
    }
    if (single < 0) {
        uint nUnder = 0, nOver = 0;
        for (uint i = 0; i < tableSize; ++i) {
            cutoffs[i] = i < length ? gAnsCounts[i] : 0;
            rightv[i] = i;
            offs1[i] = 0;
            if (cutoffs[i] > entrySize) over[nOver++] = i;
            else if (cutoffs[i] < entrySize) under[nUnder++] = i;
        }
        while (nOver > 0) {
            const uint overI = over[--nOver];
            const uint underI = under[--nUnder];
            const uint underBy = entrySize - cutoffs[underI];
            cutoffs[overI] -= underBy;
            rightv[underI] = overI;
            offs1[underI] = cutoffs[overI];
            if (cutoffs[overI] < entrySize) under[nUnder++] = overI;
            else if (cutoffs[overI] > entrySize) over[nOver++] = overI;
        }
        for (uint i = 0; i < tableSize; ++i) {
            if (cutoffs[i] == entrySize) {
                rightv[i] = i;
                offs1[i] = 0;
                cutoffs[i] = 0;
            } else {
                offs1[i] -= cutoffs[i];
            }
        }
    }
    // Symbol starts, then every slot's (symbol, offset) inverted.
    uint start = 0;
    uint starts[256];
    for (uint s = 0; s < 256; ++s) {
        const uint freq = s < length ? gAnsCounts[s] : 0;
        starts[s] = start;
        info[r * kAnsInfoStride + s] = freq | (start << 16);
        start += freq;
    }
    for (uint i = 0; i < kAnsTabSize; ++i) {
        uint sym, offset;
        if (single >= 0) {
            sym = uint(single);
            offset = i;
        } else {
            const uint b = i >> logEntrySize;
            const uint pos = i & (entrySize - 1);
            if (pos >= cutoffs[b]) {
                sym = rightv[b];
                offset = offs1[b] + pos;
            } else {
                sym = b;
                offset = pos;
            }
        }
        reverse[r * kAnsReverseStride + starts[sym] + offset] = i;
    }
}

/// ANSCoder::PutSymbol: the renormalisation bits (16 or none) this symbol
/// emits; `reverse` is the code region's reverse map (slot per symbol offset).
void ansPut(inout uint state, uint freq, uint start, StructuredBuffer<uint> reverse, uint reverseBase, out uint nbits, out uint bits) {
    nbits = 0;
    bits = 0;
    if ((state >> (32 - kAnsLogTabSize)) >= freq) {
        bits = state & 0xFFFFu;
        nbits = 16;
        state >>= 16;
    }
    state = ((state / freq) << kAnsLogTabSize) + reverse[reverseBase + start + state % freq];
}

void ansPut(inout uint state, uint freq, uint start, RWStructuredBuffer<uint> reverse, uint reverseBase, out uint nbits, out uint bits) {
    nbits = 0;
    bits = 0;
    if ((state >> (32 - kAnsLogTabSize)) >= freq) {
        bits = state & 0xFFFFu;
        nbits = 16;
        state >>= 16;
    }
    state = ((state / freq) << kAnsLogTabSize) + reverse[reverseBase + start + state % freq];
}
