// The forward 8x8 special transforms (libjxl enc_transforms-inl.h
// TransformFromPixels): IDENTITY, DCT2X2, DCT4X4, DCT4X8, DCT8X4 and AFV0..3,
// from an 8x8 pixel block (row-major) to the 64 coefficients in the layout the
// decoder's transformSpecial undoes: coefficient 0 is the block's DC (mean) and
// positions 1, 8 (and 9) carry the 2x2 or 2x1 structure of the sub-blocks'
// DCs. The small DCTs are libjxl's scaled DCT in direct form (fdctBasis) with
// the coefficient memory of transform_basis.slangh (square and tall blocks
// [horizontal][vertical], wide [vertical][horizontal]).
#pragma once

#include "sjxl/common/transform_basis.slangh"

