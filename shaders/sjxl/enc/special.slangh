/// Scaled DCT of the ny x nx (pixels) sub-block at (x0, y0) of an 8x8 block, in
/// libjxl's coefficient memory: out[memIndex(v, u, ny, nx)].
void smallDct(float pix[64], uint x0, uint y0, uint ny, uint nx, out float o[32]) {
    float rows[32];
    for (uint y = 0; y < ny; ++y) {
        for (uint u = 0; u < nx; ++u) {
            float sum = 0.0f;
            for (uint x = 0; x < nx; ++x) sum += pix[(y0 + y) * 8 + x0 + x] * fdctBasis(u, x, nx);
            rows[y * nx + u] = sum;
        }
    }
    for (uint i = 0; i < 32; ++i) o[i] = 0.0f;
    for (uint v = 0; v < ny; ++v) {
        for (uint u = 0; u < nx; ++u) {
            float sum = 0.0f;
            for (uint y = 0; y < ny; ++y) sum += rows[y * nx + u] * fdctBasis(v, y, ny);
            o[memIndex(v, u, ny, nx)] = sum;
        }
    }
}

/// DCT2TopBlock<S>: the 2x2 Haar-like step over the top-left S x S of `blk`, in place.
void dct2Top(inout float blk[64], uint s) {
    float temp[64];
    const uint n2 = s / 2;
    for (uint y = 0; y < n2; ++y) {
        for (uint x = 0; x < n2; ++x) {
            const float c00 = blk[(y * 2) * 8 + x * 2], c01 = blk[(y * 2) * 8 + x * 2 + 1];
            const float c10 = blk[(y * 2 + 1) * 8 + x * 2], c11 = blk[(y * 2 + 1) * 8 + x * 2 + 1];
            temp[y * 8 + x] = (c00 + c01 + c10 + c11) * 0.25f;
            temp[y * 8 + n2 + x] = (c00 + c01 - c10 - c11) * 0.25f;
            temp[(y + n2) * 8 + x] = (c00 - c01 + c10 - c11) * 0.25f;
            temp[(y + n2) * 8 + n2 + x] = (c00 - c01 - c10 + c11) * 0.25f;
        }
    }
    for (uint y = 0; y < s; ++y) for (uint x = 0; x < s; ++x) blk[y * 8 + x] = temp[y * 8 + x];
}

/// The forward special transform of `strategy` (1, 2, 3, 12..17) of the 8x8 block `pix`.
void forwardSpecial(uint strategy, float pix[64], out float coef[64]) {
    for (uint i = 0; i < 64; ++i) coef[i] = 0.0f;
    float o[32];
    if (strategy == 1) {   // IDENTITY
        for (uint y = 0; y < 2; ++y) {
            for (uint x = 0; x < 2; ++x) {
                float blockDc = 0.0f;
                for (uint iy = 0; iy < 4; ++iy) for (uint ix = 0; ix < 4; ++ix) blockDc += pix[(y * 4 + iy) * 8 + x * 4 + ix];
                blockDc *= 1.0f / 16.0f;
                const float center = pix[(y * 4 + 1) * 8 + x * 4 + 1];
                for (uint iy = 0; iy < 4; ++iy) {
                    for (uint ix = 0; ix < 4; ++ix) {
                        if (ix == 1 && iy == 1) continue;
                        coef[(y + iy * 2) * 8 + x + ix * 2] = pix[(y * 4 + iy) * 8 + x * 4 + ix] - center;
                    }
                }
                coef[(y + 2) * 8 + x + 2] = coef[y * 8 + x];
                coef[y * 8 + x] = blockDc;
            }
        }
    } else if (strategy == 2) {   // DCT2X2
        for (uint i = 0; i < 64; ++i) coef[i] = pix[i];
        dct2Top(coef, 8);
        dct2Top(coef, 4);
        dct2Top(coef, 2);
        return;
    } else if (strategy == 3) {   // DCT4X4
        for (uint y = 0; y < 2; ++y) {
            for (uint x = 0; x < 2; ++x) {
                smallDct(pix, x * 4, y * 4, 4, 4, o);
                for (uint iy = 0; iy < 4; ++iy) for (uint ix = 0; ix < 4; ++ix) coef[(y + iy * 2) * 8 + x + ix * 2] = o[iy * 4 + ix];
            }
        }
    } else if (strategy == 12) {   // DCT4X8: two 4-row x 8-column transforms
        for (uint y = 0; y < 2; ++y) {
            smallDct(pix, 0, y * 4, 4, 8, o);
            for (uint iy = 0; iy < 4; ++iy) for (uint ix = 0; ix < 8; ++ix) coef[(y + iy * 2) * 8 + ix] = o[iy * 8 + ix];
        }
        const float b0 = coef[0], b1 = coef[8];
        coef[0] = (b0 + b1) * 0.5f;
        coef[8] = (b0 - b1) * 0.5f;
        return;
    } else if (strategy == 13) {   // DCT8X4: two 8-row x 4-column transforms, stored [u][v]
        for (uint x = 0; x < 2; ++x) {
            smallDct(pix, x * 4, 0, 8, 4, o);
            for (uint iy = 0; iy < 4; ++iy) for (uint ix = 0; ix < 8; ++ix) coef[(x + iy * 2) * 8 + ix] = o[iy * 8 + ix];
        }
        const float b0 = coef[0], b1 = coef[8];
        coef[0] = (b0 + b1) * 0.5f;
        coef[8] = (b0 - b1) * 0.5f;
        return;
    } else if (strategy >= 14 && strategy <= 17) {   // AFV
        const uint afvX = (strategy - 14) & 1;
        const uint afvY = (strategy - 14) / 2;
        float blk[16];
        for (uint iy = 0; iy < 4; ++iy) {
            for (uint ix = 0; ix < 4; ++ix) {
                blk[(afvY == 1 ? 3 - iy : iy) * 4 + (afvX == 1 ? 3 - ix : ix)] = pix[(iy + 4 * afvY) * 8 + ix + 4 * afvX];
            }
        }
        for (uint i = 0; i < 16; ++i) {
            float sum = 0.0f;
            for (uint j = 0; j < 16; ++j) sum += blk[j] * kAfvBasis[i][j];
            coef[(i / 4) * 2 * 8 + (i % 4) * 2] = sum;
        }
        smallDct(pix, afvX == 1 ? 0 : 4, afvY * 4, 4, 4, o);
        for (uint iy = 0; iy < 4; ++iy) for (uint ix = 0; ix < 4; ++ix) coef[iy * 2 * 8 + ix * 2 + 1] = o[iy * 4 + ix];
        smallDct(pix, 0, afvY == 1 ? 0 : 4, 4, 8, o);
        for (uint iy = 0; iy < 4; ++iy) for (uint ix = 0; ix < 8; ++ix) coef[(1 + iy * 2) * 8 + ix] = o[iy * 8 + ix];
        const float b00 = coef[0] * 0.25f, b01 = coef[1], b10 = coef[8];
        coef[0] = (b00 + b01 + 2.0f * b10) * 0.25f;
        coef[1] = (b00 - b01) * 0.5f;
        coef[8] = (b00 + b01 - 2.0f * b10) * 0.25f;
        return;
    }
    // IDENTITY and DCT4X4: the 2x2 DCT of the four sub-block DCs.
    const float b00 = coef[0], b01 = coef[1], b10 = coef[8], b11 = coef[9];
    coef[0] = (b00 + b01 + b10 + b11) * 0.25f;
    coef[1] = (b00 + b01 - b10 - b11) * 0.25f;
    coef[8] = (b00 - b01 + b10 - b11) * 0.25f;
    coef[9] = (b00 - b01 - b10 + b11) * 0.25f;
}

bool isSpecialStrategy(uint s) { return s == 1 || s == 2 || s == 3 || (s >= 12 && s <= 17); }
